# ============================================================================
# ORCA configuration
# Copy to .env and edit. NEVER commit a filled-in .env.
# Every variable is optional; the defaults below give a working demo.
# ============================================================================

# --- identity ---------------------------------------------------------------
ORCA_ENVIRONMENT=dev                 # dev | demo | staging | prod

# --- data sourcing ----------------------------------------------------------
# true  = every provider resolves to its deterministic demo implementation.
#         Values are labelled DEMO end to end and are never called live.
# false = live providers; at least one must be enabled below or startup fails.
ORCA_DEMO_MODE=true

# If a live provider fails, may demo fixtures stand in for it? Default NO, and
# you should leave it NO. Demo data must never masquerade as a live reading.
ORCA_ALLOW_LIVE_FALLBACK_TO_DEMO=false

# --- IMD (India Meteorological Department) ----------------------------------
# Atmospheric conditions, marine/coastal bulletins, port warnings, cyclone track.
# ACCESS: https://api.imd.gov.in/api/v1/ - IMD requires IP WHITELISTING.
# Portal account: https://api.imd.gov.in/public/register.php
# Whitelist request + support contacts: https://mausam.imd.gov.in/responsive/apis.php
# Full step-by-step for IMD, INCOIS and MOSDAC: docs/indian-sources.md
# You must also supply app/data/providers/imd_fields.json (see that folder's
# README) - ORCA will not guess response field names.
ORCA_IMD_ENABLED=false
ORCA_IMD_API_BASE=https://api.imd.gov.in/api/v1

# --- INCOIS -----------------------------------------------------------------
# Ocean state, waves, currents, SST, PFZ.
# ACCESS: ERDDAP at https://erddap.incois.gov.in/erddap (public datasets, no key).
# Run `python -m app.tools.discover_incois` to list real dataset ids, then fill
# app/data/providers/incois_datasets.json.
ORCA_INCOIS_ENABLED=false
ORCA_INCOIS_ERDDAP_BASE=https://erddap.incois.gov.in/erddap

# --- MOSDAC / ISRO ----------------------------------------------------------
# Satellite EO. ACCESS: account-authenticated, order-based data download API
# (documented client mdapi.py). Create an account at https://mosdac.gov.in/signup/
# NOTE: this is an archive ordering interface, not a real-time query API.
ORCA_MOSDAC_ENABLED=false
ORCA_MOSDAC_API_BASE=https://www.mosdac.gov.in
ORCA_MOSDAC_USERNAME=
ORCA_MOSDAC_PASSWORD=

# ============================================================================
# FREE LIVE SOURCES — how to get real data with no money and no card
# ============================================================================
# Read docs/live-data.md for the full comparison. Short version:
#
#   Want real live data in 60 seconds, zero signup?
#       ORCA_DEMO_MODE=false          <- that alone gives you live wind AND waves
#
#   Want a second atmospheric source?  Add a free OpenWeatherMap key below.
#   Want the Indian authorities?       IMD needs an IP whitelist; INCOIS needs
#                                      one discovery run. Both are free.
# ----------------------------------------------------------------------------

# --- Open-Meteo (NO KEY AT ALL — the fastest route to live data) ------------
# Free for non-commercial use, no signup, no card. Covers BOTH atmosphere
# (wind, gusts, rain, visibility, cloud, CAPE) and ocean (wave height, swell,
# period, SST, currents). Attribution to Open-Meteo and DWD is required and is
# carried automatically in every source card.
# This is enabled by default and is all you need for a live demo.
ORCA_OPENMETEO_ENABLED=true
ORCA_OPENMETEO_FORECAST_BASE=https://api.open-meteo.com/v1/forecast
ORCA_OPENMETEO_MARINE_BASE=https://marine-api.open-meteo.com/v1/marine

# --- OpenWeatherMap (FREE KEY, NO CREDIT CARD) ------------------------------
# The most generous free atmospheric source we verified: 60 calls/minute and
# 1,000,000 calls/month on the classic /data/2.5/* endpoints, with no card.
# Sign up: https://home.openweathermap.org/users/sign_up
# A new key can take up to ~2 hours to activate; until then it returns 401 and
# ORCA reports the source as NOT_CONFIGURED rather than guessing a value.
#
# Use it as a SECOND atmospheric source: with two sources ORCA's conflict layer
# has something real to reconcile, which is worth showing a judge.
ORCA_OPENWEATHERMAP_ENABLED=false
ORCA_OPENWEATHERMAP_API_KEY=
ORCA_OPENWEATHERMAP_BASE=https://api.openweathermap.org/data/2.5


# --- INCOIS OceanSat-2 OCM map layer (the ocean-colour layer on the map) -----
# Verified dataset: incois_oceansat2_datasets on the official INCOIS ERDDAP.
# Variables: CHL (mg/m3) · KD490 (m^-1) · TSM (mg/L). Observation product.
#
# TO GET REAL INCOIS DATA ON THE MAP, on a machine that can reach INCOIS:
#     ORCA_DEMO_MODE=false
#     ORCA_INCOIS_ENABLED=true
# That is the whole switch. The map layer then calls the real ERDDAP endpoint;
# if it cannot be reached the layer renders "INCOIS DATA UNAVAILABLE" and shows
# no values at all. Demo values are never emitted under the INCOIS label.
ORCA_OCEANSAT_DATASET_ID=incois_oceansat2_datasets
# ERDDAP's index selector is positional, so axis order is configuration, not an
# assumption. Change only if the server reports a different dimension order.
ORCA_OCEANSAT_AXIS_ORDER=time,latitude,longitude
ORCA_OCEANSAT_DEFAULT_VARIABLE=CHL
ORCA_OCEANSAT_HALF_DEGREES=0.75      # bbox half-width; keeps the fetch small
ORCA_OCEANSAT_MAX_CELLS=4000         # ceiling on cells sent to the browser
ORCA_OCEANSAT_CACHE_TTL_SECONDS=1800

# --- LLM (entirely optional) -------------------------------------------------
# ORCA answers every demo query with NO model configured. The LLM is only ever
# a fallback for ambiguous intent and an optional phrasing pass whose output is
# rejected if it introduces a number not in the evidence.
ORCA_LLM_PROVIDER=none               # none | openai_compatible | anthropic
ORCA_LLM_BASE_URL=
ORCA_LLM_API_KEY=
ORCA_LLM_MODEL=
ORCA_LLM_TIMEOUT_MS=2500
ORCA_LLM_ENABLE_FOR_NLU_FALLBACK=true
ORCA_LLM_ENABLE_FOR_EXPLANATION=false

# --- latency budgets (milliseconds) -----------------------------------------
ORCA_BUDGET_TOTAL_MS=3000
ORCA_BUDGET_PROVIDER_MS=1800
ORCA_BUDGET_AGENT_MS=2200
ORCA_PROVIDER_CONNECT_TIMEOUT_MS=700
ORCA_PROVIDER_RETRY_ATTEMPTS=1
ORCA_PROVIDER_RETRY_BACKOFF_MS=120

# --- circuit breaker ---------------------------------------------------------
ORCA_BREAKER_FAILURE_THRESHOLD=4
ORCA_BREAKER_RESET_SECONDS=30

# --- cache -------------------------------------------------------------------
ORCA_CACHE_BACKEND=memory            # memory | redis
ORCA_REDIS_URL=
ORCA_CACHE_MAX_ENTRIES=4096

# --- behaviour ---------------------------------------------------------------
ORCA_DEFAULT_LANGUAGE=en
ORCA_CONVERSATION_TTL_SECONDS=3600
ORCA_MAX_CONVERSATION_TURNS=20
ORCA_EXPOSE_TRACE_IN_RESPONSE=true   # set false in production

# --- server ------------------------------------------------------------------
ORCA_HOST=0.0.0.0
ORCA_PORT=8000
ORCA_CORS_ORIGINS=*

# ============================================================================
# Demo-mode switches. These only do anything when ORCA_DEMO_MODE=true.
# They exist so failure behaviour can be demonstrated on stage and asserted in
# tests, rather than described in a slide.
# ============================================================================
# ORCA_DEMO_SCENARIO=normal          # calm | normal | rough | pre_cyclone
# ORCA_DEMO_FAIL_SOURCES=INCOIS      # comma-separated: IMD,INCOIS,MOSDAC
# ORCA_DEMO_SLOW_SOURCES=IMD:2500    # source:milliseconds
# ORCA_DEMO_STALE_SOURCES=IMD        # force stale timestamps
# ORCA_DEMO_CONFLICT=true            # make IMD and INCOIS disagree about wind
